    "toast": {
      "word": "toast",
      "phonetic": "/toust/",
      "pos": [
        "n",
        "vi",
        "vt"
      ],
      "definitions": [
        {
          "pos": "n",
          "meaning": "烤面包片"
        },
        {
          "pos": "n",
          "meaning": "烤面包片机 17世纪的英国有一种习俗：人们饮酒时，喜爱把加有香料 的烤面包片( toast ) 放入酒中，据说能使酒的味道更美。 后来在祝酒时，有人开始用toast 指代被祝酒的女士，象征 被祝酒者像加有香料的烤面包片一样会为酒增添风味。所 以有了现在的说法： Let's drink a toast to...(让我们为 …… 干 一杯!)toast也有了“为……干杯，向……祝酒”的词义。"
        },
        {
          "pos": "vt",
          "meaning": "为…举杯敬酒"
        },
        {
          "pos": "vi",
          "meaning": "烤 (尤指面包)，把…烤得焦黄"
        }
      ],
      "memory": "",
      "collocations": [],
      "examples": [
        {
          "en": "Toast is one of the most popular dishes on the menu.",
          "cn": "烤面包片：烤面包片是菜单上最受欢迎的菜之一。"
        }
      ],
      "source": "真经",
      "phonetic_uk": "təʊst",
      "phonetic_us": "toʊst"
    },
