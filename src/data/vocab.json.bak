    "depression": {
      "word": "depression",
      "phonetic": "/dr'preʃən/",
      "pos": [
        "n"
      ],
      "definitions": [
        "沮丧，消沉；萧条期，不景气 美国历史上一次空前严重的经济危机。年10月，股票 价格与9月初相比猛跌40%以上。年至年，美国 众多银行和公司破产。据年9月《财富》杂志给出的 信息，约占美国全国总人口28%的人没有足够的收入。而 且 ，当年有万人到处流浪。在这次大萧条中，工业、农 业、信用危机并发，并波及整个资本主义世界，使世界工业 生产总产值下降36%,世界贸易缩减三分之二。",
        {
          "pos": "n",
          "meaning": "洼地，坑；低气压"
        },
        "忧郁、沮丧"
      ],
      "memory": "A holiday may help him cope with feelings of depression. 度假也许能帮助他改善抑郁情绪。 depress v.使沮丧；使萧条 Great Depression (大萧条):",
      "collocations": [],
      "examples": [
        {
          "en": "We spent a long time discussing depression during the meeting yesterday.",
          "cn": "沮丧：We spent a long time discussing depression during the meeting yesterday."
        }
      ],
      "source": "真经",
      "phonetic_uk": "dɪˈprɛʃən",
      "phonetic_us": "dɪˈprɛʃən"
    },
