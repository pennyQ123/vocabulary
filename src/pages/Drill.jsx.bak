import { useState, useEffect, useCallback, useRef } from 'react';
import { getDrillQueue, setDrillResult, db, getNotes, addNote } from '../store/drillStore';
import synonymsData from '../data/synonyms.json';
import './Drill.css';

let cachedVoices = null;

function getVoices() {
  return new Promise((resolve) => {
    const synth = window.speechSynthesis;
    if (!synth) return resolve([]);
    const voices = synth.getVoices();
    if (voices.length > 0) return resolve(voices);
    synth.onvoiceschanged = () => resolve(synth.getVoices());
    // Fallback timeout
    setTimeout(() => resolve(synth.getVoices()), 500);
  });
}

async function speakWord(word) {
  const synth = window.speechSynthesis;
  if (!synth) return;
  synth.cancel();
  const utter = new SpeechSynthesisUtterance(word);
  utter.lang = 'en-US';
  utter.rate = 0.85;
  utter.pitch = 1.05;
  if (!cachedVoices || cachedVoices.length === 0) {
    cachedVoices = await getVoices();
  }
  const preferred = cachedVoices.find(v => v.lang === 'en-US' && v.name.includes('Samantha'))
    || cachedVoices.find(v => v.lang === 'en-US' && v.name.includes('Karen'))
    || cachedVoices.find(v => v.lang === 'en-US' && v.name.includes('Zira'))
    || cachedVoices.find(v => v.lang === 'en-US' && v.name.includes('Female'))
    || cachedVoices.find(v => v.lang === 'en-US' && v.name.includes('Susan'))
    || cachedVoices.find(v => v.lang === 'en-US' && v.name.includes('Linda'))
    || cachedVoices.find(v => v.lang === 'en-US' && v.name.includes('Mary'))
    || cachedVoices.find(v => v.lang === 'en-US')
    || cachedVoices.find(v => v.lang.startsWith('en'));
  if (preferred) utter.voice = preferred;
  synth.speak(utter);
}

export default function Drill() {
  const [queue, setQueue] = useState([]);
  const [index, setIndex] = useState(0);
  const [phase, setPhase] = useState('question');
  const [sessionStats, setSessionStats] = useState({ correct: 0, wrong: 0 });
  const [animating, setAnimating] = useState(false);
  const [noteText, setNoteText] = useState('');
  const [noteId, setNoteId] = useState(null);
  const noteTimerRef = useRef(null);
  const [lastResult, setLastResult] = useState(null);
  const [loading, setLoading] = useState(true);
  const [sessionDone, setSessionDone] = useState(false);
  const [pendingWord, setPendingWord] = useState(null);
  const [cardState, setCardState] = useState('idle');
  const [totalStats, setTotalStats] = useState({ drilled: 0, correct: 0, wrong: 0, total: 0 });
  useEffect(() => {
    async function build() {
      const q = await getDrillQueue();
      setQueue(q.slice(0, 10));
      const all = await db.drillProgress.toArray();
      const total = all.reduce((acc, p) => ({
        drilled: acc.drilled + (p.total || 0),
        correct: acc.correct + (p.correct || 0),
        wrong: acc.wrong + ((p.total || 0) - (p.correct || 0)),
      }), { drilled: 0, correct: 0, wrong: 0 });
      total.total = (await import('../data/vocab.json')).default.words
        ? Object.keys((await import('../data/vocab.json')).default.words).length : 0;
      setTotalStats(total);
      setLoading(false);
    }
    build();
  }, []);

  // Load notes when word changes
  useEffect(() => {
    if (!current?.word) return;
    getNotes(current.word).then(notes => {
      if (notes && notes.length > 0) {
        setNoteText(notes[0].content || '');
        setNoteId(notes[0].id);
      } else {
        setNoteText('');
        setNoteId(null);
      }
    });
  }, [current?.word]);

  // Auto-save notes with 500ms debounce
  useEffect(() => {
    if (!current?.word) return;
    if (noteTimerRef.current) clearTimeout(noteTimerRef.current);
    noteTimerRef.current = setTimeout(async () => {
      const trimmed = noteText.trim();
      if (noteId) {
        // Update existing note
        await db.notes.update(noteId, { content: trimmed });
        if (!trimmed) {
          await db.notes.delete(noteId);
          setNoteId(null);
        }
      } else if (trimmed) {
        // Create new note
        await addNote({ word: current.word, content: trimmed });
        // Re-fetch to get the auto-generated id
        const notes = await getNotes(current.word);
        if (notes.length > 0) setNoteId(notes[0].id);
      }
    }, 500);
    return () => clearTimeout(noteTimerRef.current);
  }, [noteText]);

  // 进入 reveal 阶段自动朗读一次
  useEffect(() => {
    if (phase === 'reveal' && current?.word) {
      speakWord(current.word);
    }
  }, [phase, index]); // phase 或 index 变化时触发

  const current = queue[index];

  const handleJudge = useCallback(async (known) => {
    if (!current || animating) return;
    setPendingWord({ word: current.word, known, index });
    setLastResult(known ? 'correct' : 'wrong');
    setAnimating(true);
    setPhase('reveal');
    await setDrillResult(current.word, known);
    setSessionStats(s => ({
      ...s,
      correct: s.correct + (known ? 1 : 0),
      wrong: s.wrong + (known ? 0 : 1),
    }));
    setTotalStats(prev => ({
      ...prev,
      drilled: prev.drilled + 1,
      correct: prev.correct + (known ? 1 : 0),
      wrong: prev.wrong + (known ? 0 : 1),
    }));
    setTimeout(() => setAnimating(false), 350);
  }, [current, animating, index]);

  const undoLast = useCallback(async () => {
    if (!pendingWord) return;
    const { word, known } = pendingWord;
    await setDrillResult(word, null, true);
    setSessionStats(s => ({
      ...s,
      correct: s.correct - (known ? 1 : 0),
      wrong: s.wrong - (known ? 0 : 1),
    }));
    setTotalStats(prev => ({
      ...prev,
      drilled: prev.drilled - 1,
      correct: prev.correct - (known ? 1 : 0),
      wrong: prev.wrong - (known ? 0 : 1),
    }));
    setPendingWord(null);
    setLastResult(null);
    setPhase('question');
    setCardState('idle');
  }, [pendingWord]);

  const handleNext = useCallback(() => {
    if (cardState !== 'idle') return; // 防止连续点击跳词
    setLastResult(null);
    setPhase('question');
    setCardState('turning-out');
    setTimeout(() => {
      if (index + 1 >= queue.length) {
        setSessionDone(true);
      } else {
        setIndex(i => i + 1);
        setCardState('turning-in');
        setTimeout(() => setCardState('idle'), 350);
      }
    }, 280);
  }, [index, queue.length, cardState]);

  const restart = async () => {
    const q = await getDrillQueue();
    setQueue(q.slice(0, 10));
    setIndex(0);
    setPhase('question');
    setSessionStats({ correct: 0, wrong: 0 });
    setSessionDone(false);
    setLastResult(null);
    setPendingWord(null);
    setCardState('idle');
    setAnimating(false);
  };

  if (loading) {
    return (
      <div className="drill-loading">
        <div className="drill-loading__spinner" />
        <p>正在加载词库...</p>
      </div>
    );
  }

  if (sessionDone) {
    const rate = sessionStats.correct + sessionStats.wrong > 0
      ? Math.round((sessionStats.correct / (sessionStats.correct + sessionStats.wrong)) * 100) : 0;
    return (
      <div className="drill-session-done">
        <div className="drill-session-done__card">
          <div className="drill-session-done__stamp">
            {rate >= 80 ? 'GREAT!' : rate >= 50 ? 'GOOD!' : 'KEEP GOING!'}
          </div>
          <h2 className="drill-session-done__title">本轮结束</h2>
          <div className="drill-session-done__stats">
            <div className="drill-stat drill-stat--correct">
              <span className="drill-stat__num">{sessionStats.correct}</span>
              <span className="drill-stat__label">认识 ✓</span>
            </div>
            <div className="drill-session-done__divider" />
            <div className="drill-stat drill-stat--wrong">
              <span className="drill-stat__num">{sessionStats.wrong}</span>
              <span className="drill-stat__label">再记 ✗</span>
            </div>
          </div>
          <div className="drill-session-done__rate">{rate}% 正确率</div>
          <button className="drill-btn drill-btn--restart" onClick={restart}>
            再来一轮
          </button>
        </div>
      </div>
    );
  }

  if (!current) {
    return (
      <div className="drill-loading">
        <div className="drill-loading__spinner" />
        <p>正在准备单词...</p>
      </div>
    );
  }

  const word = current.word;
  const phonetic = current.phonetic || '';
  const definitions = current.definitions || [];
  const memory = current.memory || '';
  const pos = Array.isArray(current.pos) ? current.pos : [];
  const progress = current.progress || {};

  const relatedWords = [];
  if (memory && typeof memory === 'string' && memory.trim()) {
    const relMatch = memory.matchAll(/([a-zA-Z\-]+)\s+(adj\.?|n\.?|v\.?|adv\.?|vi\.?|vt\.?)\s*([^，,。\n]+)?/gi);
    for (const m of relMatch) {
      const [, rw, rwPos, rwDef] = m;
      if (rw.toLowerCase() !== word.toLowerCase()) {
        relatedWords.push({ word: rw, pos: rwPos.replace('.', ''), meaning: rwDef ? rwDef.trim().replace(/[，。]$/, '') : '' });
      }
    }
  }

  const posColors = {
    n: { bg: 'rgba(74, 122, 90, 0.15)', color: 'var(--accent-n)' },
    v: { bg: 'rgba(139, 74, 74, 0.15)', color: 'var(--accent-v)' },
    adj: { bg: 'rgba(184, 120, 58, 0.15)', color: 'var(--accent-adj)' },
    adv: { bg: 'rgba(107, 106, 138, 0.15)', color: 'var(--accent-adv)' },
    vt: { bg: 'rgba(139, 74, 74, 0.15)', color: 'var(--accent-vt)' },
    vi: { bg: 'rgba(136, 128, 160, 0.15)', color: 'var(--accent-vi)' },
  };

  return (
    <div className="drill" style={{ position: 'relative' }}>
      {/* Header */}
      <div className="drill-header">
        <div className="drill-header__counter">
          <span className="drill-header__current">{index + 1}</span>
          <span className="drill-header__sep">/</span>
          <span className="drill-header__total">{queue.length}</span>
        </div>
        <div className="drill-header__bar">
          <div className="drill-header__fill" style={{ width: `${(index / queue.length) * 100}%` }} />
        </div>
        <div className="drill-header__session-stats">
          <span className="drill-stat-inline drill-stat-inline--correct">✓ {sessionStats.correct}</span>
          <span className="drill-stat-inline drill-stat-inline--wrong">✗ {sessionStats.wrong}</span>
        </div>
        {pendingWord && (
          <button className="drill-header__undo" onClick={undoLast}>
            ↩ 撤销
          </button>
        )}
      </div>

      {/* Total Progress */}
      {totalStats.total > 0 && (
        <div className="drill-total-progress">
          <div className="drill-total-progress__label">
            <span>总进度</span>
            <span>{totalStats.drilled} / {totalStats.total} 词</span>
          </div>
          <div className="drill-total-progress__bar">
            <div className="drill-total-progress__fill" style={{ width: `${Math.min((totalStats.drilled / totalStats.total) * 100, 100)}%` }} />
          </div>
          <div className="drill-total-progress__stats">
            <span style={{ color: 'var(--lotus)' }}>✓ {totalStats.correct}</span>
            <span style={{ color: 'var(--lotus-dark)' }}>✗ {totalStats.wrong}</span>
          </div>
        </div>
      )}

      {/* Note Panel — left side */}
      <div className="drill-note-panel" style={{
        position: 'absolute',
        left: `max(8px, calc((100vw - 760px) / 2))`,
        top: 120,
        width: 200,
        zIndex: 5,
        display: 'flex',
        flexDirection: 'column',
      }}>
        <div style={{
          background: 'var(--paper-surface)',
          border: '1px solid var(--border-light)',
          borderRadius: 12,
          padding: 12,
          boxShadow: 'var(--shadow-paper)',
        }}>
          <div style={{
            fontFamily: 'var(--font-title)', fontSize: 11,
            color: 'var(--ink-faded)', fontWeight: 600,
            letterSpacing: '0.12em', textTransform: 'uppercase',
            marginBottom: 8,
          }}>笔记</div>
          <textarea
            value={noteText}
            onChange={e => setNoteText(e.target.value)}
            placeholder="写点笔记..."
            style={{
              width: '100%',
              minHeight: 140,
              background: 'rgba(30, 44, 35, 0.03)',
              border: '1px solid rgba(184, 138, 58, 0.12)',
              borderRadius: 8,
              padding: '10px 12px',
              fontFamily: 'var(--font-body)',
              fontSize: 13,
              color: 'var(--ink-primary)',
              resize: 'vertical',
              outline: 'none',
              lineHeight: 1.7,
            }}
          />
        </div>
      </div>

      {/* Priority badge */}
      {progress.unknownCount > 0 && (
        <div className="drill-priority-badge">
          <span className="drill-priority-badge__dot" />
          本词已忘记 {progress.unknownCount} 次
        </div>
      )}

      {/* Card */}
      <div className="drill-card-wrapper">
        <div className={[
          'drill-card',
          phase === 'reveal' ? 'drill-card--revealed' : '',
          animating ? `drill-card--anim-${lastResult}` : '',
          cardState === 'turning-out' ? 'turning-out' : '',
          cardState === 'turning-in' ? 'turning-in' : '',
        ].join(' ')}>

          {/* Word */}
          <div className="drill-card__word-row">
            <div className={`drill-card__word drill-card__word--${word.length <= 6 ? 'short' : word.length <= 10 ? 'medium' : 'long'}`}>{word}</div>
            <button className="drill-card__speak-btn" onClick={() => speakWord(word)} title="朗读">🔊</button>
          </div>
          {phase === 'reveal' && phonetic && (
            <div className="drill-card__phonetic">{phonetic}</div>
          )}

          <div className="drill-card__divider" />

          {/* Revealed section */}
          {phase === 'reveal' && (
            <div className="drill-card__reveal">
              {/* POS tags — below word, alongside definitions */}
              {pos.length > 0 && (
                <div className="drill-card__pos-tags" style={{ justifyContent: 'center', marginBottom: 12 }}>
                  {pos.map(p => (
                    <span key={p} className={`drill-pos-tag drill-pos-tag--${p}`}>{p}</span>
                  ))}
                </div>
              )}
              <ul className="drill-card__def-list">
                {definitions.length > 0 ? definitions.map((d, i) => (
                  <li key={i} className="drill-card__def-item">
                    {typeof d === 'string' ? d : (
                      <>
                        {pos.length > 1 && d.pos && <span className="drill-def-pos">{d.pos}.</span>}
                        {d.meaning}
                      </>
                    )}
                  </li>
                )) : (
                  <li className="drill-card__def-empty">（暂无释义）</li>
                )}
              </ul>

              {/* Memory — right after definitions */}
              {(() => {
                const mem = current.memory;
                if (!mem) return null;
                if (typeof mem === 'string' && mem.trim()) {
                  return (
                    <div className="drill-card__memory" style={{ marginTop: 14 }}>
                      <div className="drill-card__memory-label">记忆法</div>
                      <div className="drill-card__memory-content">{mem}</div>
                    </div>
                  );
                }
                if (Array.isArray(mem) && mem.length > 0) {
                  return (
                    <div className="drill-card__memory" style={{ marginTop: 14 }}>
                      <div className="drill-card__memory-label">记忆法</div>
                      {mem.map((m, i) => (
                        <div key={i} className="drill-card__memory-content" style={{ marginBottom: i < mem.length - 1 ? 6 : 0 }}>
                          {m.type && <span style={{ fontWeight: 600, color: 'var(--night-sea)' }}>{m.type}：</span>}
                          {m.content}
                        </div>
                      ))}
                    </div>
                  );
                }
                return null;
              })()}

              {/* Collocations */}
              {current.collocations && current.collocations.length > 0 && (
                <div className="drill-card__word-group">
                  <div className="drill-card__word-group-title">短语搭配</div>
                  <div className="drill-card__word-group-list">
                    {current.collocations.map((c, i) => (
                      <div key={i} className="drill-card__related-word">
                        <span className="drill-related-word__meaning" style={{ fontStyle: 'normal' }}>{c}</span>
                      </div>
                    ))}
                  </div>
                </div>
              )}

              {relatedWords.length > 0 && (
                <div className="drill-card__word-group">
                  <div className="drill-card__word-group-title">形近词·近义词</div>
                  <div className="drill-card__word-group-list">
                    {relatedWords.map((rw, i) => (
                      <div key={i} className="drill-card__related-word">
                        <span className="drill-related-word__text" style={posColors[rw.pos] ? { background: posColors[rw.pos].bg, color: posColors[rw.pos].color } : {}}>
                          {rw.word}
                          {rw.pos && <span className="drill-related-word__pos"> {rw.pos}</span>}
                        </span>
                        {rw.meaning && <span className="drill-related-word__meaning">{rw.meaning}</span>}
                      </div>
                    ))}
                  </div>
                </div>
              )}

              {/* Synonyms from synonyms.json */}
              {phase === 'reveal' && synonymsData[word.toLowerCase()] && synonymsData[word.toLowerCase()].length > 0 && (
                <div className="drill-card__word-group">
                  <div className="drill-card__word-group-title">近义词</div>
                  <div className="drill-card__word-group-list">
                    {synonymsData[word.toLowerCase()].map((syn, i) => (
                      <div key={i} className="drill-card__related-word">
                        <span className="drill-related-word__text" style={{ background: 'rgba(184, 138, 58, 0.15)', color: 'var(--lotus)' }}>
                          {syn}
                        </span>
                      </div>
                    ))}
                  </div>
                </div>
              )}

              {current.examples && current.examples.length > 0 && (
                <div className="drill-card__examples">
                  <div className="drill-card__examples-label">例句</div>
                  {current.examples.slice(0, 2).map((ex, i) => (
                    <div key={i} className="drill-card__example-item">
                      {typeof ex === 'string' ? ex : (
                        <>
                          <div>{ex.en}</div>
                          {ex.cn && <div style={{ fontStyle: 'normal', color: 'var(--ink-secondary)', marginTop: 4 }}>{ex.cn}</div>}
                        </>
                      )}
                    </div>
                  ))}
                </div>
              )}
            </div>
          )}

          {/* Stamp overlay */}
          {lastResult && (
            <div className={`drill-card__stamp drill-card__stamp--${lastResult}`}>
              {lastResult === 'correct' ? '主人你真厉害~ ✨' : '主人，加油呀 💪'}
            </div>
          )}
        </div>
      </div>

      {/* Actions */}
      <div className="drill-actions">
        {phase === 'question' ? (
          <div className="drill-actions__judge">
            <button className="drill-btn drill-btn--wrong" onClick={() => handleJudge(false)} disabled={animating}>
              <span className="drill-btn__icon">✗</span>
              <span className="drill-btn__text">不认识</span>
            </button>
            <button className="drill-btn drill-btn--correct" onClick={() => handleJudge(true)} disabled={animating}>
              <span className="drill-btn__icon">✓</span>
              <span className="drill-btn__text">认识</span>
            </button>
          </div>
        ) : (
          <button className="drill-btn drill-btn--next" onClick={handleNext}>
            下一个 →
          </button>
        )}
      </div>

      <div className="drill-hint">
        {phase === 'question' ? '先回忆词义，判断是否认识' : '查看释义后，进入下一词'}
      </div>
    </div>
  );
}